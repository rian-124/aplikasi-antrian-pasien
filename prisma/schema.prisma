// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(200)
  password String @db.VarChar(100)
  role_id Int @db.Integer
  roles Roles @relation(fields: [role_id], references: [id])
  created_At DateTime @default(now()) @db.Timestamptz()
  updated_At DateTime @updatedAt  @db.Timestamptz()
  @@map("users")
}

model Roles {
  id Int @id @default(autoincrement())
  name String @db.VarChar(100)
  users Users[]
  created_At DateTime @default(now()) @db.Timestamptz()
  updated_At DateTime @updatedAt @db.Timestamptz()
  @@map("roles") 
}

model Pasiens {
  id Int @id @default(autoincrement())
  nomor_antrian_id Int @unique @db.Integer
  nomor_registrasi String @db.VarChar(100)
  jenis_registrasi_id Int @db.Integer
  status_registrasi_id Int @db.Integer
  nomor_antrian NomorAntrians @relation(fields: [nomor_antrian_id], references: [id])
  jenis_registrasis JenisRegistrasis @relation(fields: [jenis_registrasi_id], references: [id])
  status_registrasis StatusRegistrais @relation(fields: [status_registrasi_id], references: [id])
  created_At DateTime @default(now()) @db.Timestamptz()
  updated_At DateTime @updatedAt @db.Timestamptz()
  @@map("pasiens")
}

model StatusRegistrais {
  id Int @id @default(autoincrement())
  status String @unique @db.VarChar(100)
  pasien Pasiens[]
  created_At DateTime @default(now()) @db.Timestamptz()
  update_At DateTime @updatedAt @db.Timestamptz()
  @@map("status_registrasis")
}

model JenisRegistrasis {
  id Int @id @default(autoincrement())
  jenis String @unique @db.VarChar(100)
  pasien Pasiens[]
  created_At DateTime @default(now()) @db.Timestamptz()
  update_At DateTime @updatedAt @db.Timestamptz()
  @@map("jenis_registrasis")
}

model NomorAntrians {
  id Int @id @default(autoincrement())
  nomor String @unique @db.VarChar(100)
  pasien Pasiens?
  status_antrians_id Int @db.Integer()
  tahap_antrian_id Int @db.Integer()
  tahap_antrian TahapAntrians @relation(fields: [tahap_antrian_id], references: [id])
  status_antrians StatusAntrians @relation(fields: [status_antrians_id], references: [id])
  created_At DateTime @default(now()) @db.Timestamptz()
  update_At DateTime @updatedAt @db.Timestamptz()
  @@map("nomor_antrians")
}

model AntrianPasiens {
  id Int @id @default(autoincrement())
  nomor_Antrian_id Int @db.Integer
  tahap_antrian_id Int @db.Integer
  status_antrian_id Int @db.Integer
  status_antrian StatusAntrians @relation(fields: [status_antrian_id], references: [id])
  tahap_antrian TahapAntrians @relation(fields: [tahap_antrian_id], references: [id])
  created_At DateTime @default(now()) @db.Timestamptz()
  update_At DateTime @updatedAt
  @@map("antrian_pasiens")
}

model TahapAntrians {
  id Int @id @default(autoincrement())
  tahap String @unique @db.VarChar(100)
  antrian_pasien AntrianPasiens[]
  nomor_antrian NomorAntrians[]
  created_At DateTime @default(now())
  update_At DateTime @updatedAt
  @@map("tahap_antrians")
}

model StatusAntrians {
  id Int @id @default(autoincrement())
  status String @unique @db.VarChar(100)
  antrian_pasien AntrianPasiens[]
  nomor_antrian NomorAntrians[]
  created_At DateTime @default(now())
  update_At DateTime @updatedAt
  @@map("status_antrians")
}



