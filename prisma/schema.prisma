// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id              Int              @id @default(autoincrement())
  email           String           @unique @db.VarChar()
  name            String           @db.VarChar()
  password        String           @db.VarChar(100)
  role_id         Int              @db.Integer
  outlet_id       Int              @db.Integer
  antrian_pasiens AntrianPasiens[]
  outlets         Outlets          @relation(fields: [outlet_id], references: [id])
  roles           Roles            @relation(fields: [role_id], references: [id])
  created_At      DateTime         @default(now()) @db.Timestamptz()
  updated_At      DateTime         @updatedAt @db.Timestamptz()

  @@map("users")
}

model Outlets {
  id              Int              @id @default(autoincrement())
  nama_outlet     String           @unique @db.VarChar()
  users           Users[]
  antrian_pasiens AntrianPasiens[]
  created_At      DateTime         @default(now()) @db.Timestamptz()
  update_At       DateTime         @updatedAt

  @@map("outlets")
}

model Roles {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  users      Users[]
  created_At DateTime @default(now()) @db.Timestamptz()
  updated_At DateTime @updatedAt @db.Timestamptz()

  @@map("roles")
}

model Pasiens {
  id                   Int               @id @default(autoincrement())
  nomor_registrasi     String            @db.VarChar(100)
  jenis_registrasi_id  Int               @db.Integer
  penjamin_id          Int?              @db.Integer
  status_registrasi_id Int               @db.Integer
  sample_id            Int               @db.Integer
  samples              Samples           @relation(fields: [sample_id], references: [id])
  jenis_registrasis    JenisRegistrasis  @relation(fields: [jenis_registrasi_id], references: [id])
  penjamin             Penjamins?         @relation(fields: [penjamin_id], references: [id])
  status_registrasis   StatusRegistrasis @relation(fields: [status_registrasi_id], references: [id])
  created_At           DateTime          @default(now()) @db.Timestamptz()
  updated_At           DateTime          @updatedAt @db.Timestamptz()
  AntrianPasiens       AntrianPasiens[]

  @@map("pasiens")
}

model JenisRegistrasis {
  id         Int        @id @default(autoincrement())
  jenis      String     @unique @db.VarChar(100)
  pasien     Pasiens[]
  penjamin   Penjamins[]
  created_At DateTime   @default(now()) @db.Timestamptz()
  update_At  DateTime   @updatedAt @db.Timestamptz()

  @@map("jenis_registrasis")
}

model Penjamins {
  id                  Int              @id @default(autoincrement())
  nama                String           @unique @db.VarChar(100)
  jenis_registrasi_id Int              @db.Integer()
  jenis_registrasi    JenisRegistrasis @relation(fields: [jenis_registrasi_id], references: [id])
  pasiens             Pasiens[]
  created_At          DateTime         @default(now()) @db.Timestamptz()
  update_At           DateTime         @updatedAt @db.Timestamptz()
  @@map("penjamins")
}

model AntrianPasiens {
  id                Int            @id @default(autoincrement())
  pasien_id         Int
  user_id           Int?
  nomor_Antrian     String         @db.VarChar()
  tahap_antrian_id  Int            @db.Integer
  status_antrian_id Int            @db.Integer
  outlet_id         Int            @db.Integer
  bintang           Int            @default(0) @db.Integer()
  users             Users?         @relation(fields: [user_id], references: [id])
  outlets           Outlets        @relation(fields: [outlet_id], references: [id])
  pasien            Pasiens        @relation(fields: [pasien_id], references: [id])
  status_antrian    StatusAntrians @relation(fields: [status_antrian_id], references: [id])
  tahap_antrian     TahapAntrians  @relation(fields: [tahap_antrian_id], references: [id])
  created_At        DateTime       @default(now()) @db.Timestamptz()
  update_At         DateTime       @updatedAt

  @@map("antrian_pasiens")
}

model Samples {
  id          Int       @id @default(autoincrement())
  name_sample String    @unique @db.VarChar()
  Pasiens     Pasiens[]
  created_At  DateTime  @default(now())
  update_t    DateTime  @updatedAt

  @@map("samples")
}

model StatusRegistrasis {
  id         Int       @id @default(autoincrement())
  status     String    @unique @db.VarChar(100)
  pasien     Pasiens[]
  created_At DateTime  @default(now()) @db.Timestamptz()
  update_At  DateTime  @updatedAt @db.Timestamptz()

  @@map("status_registrasis")
}

model TahapAntrians {
  id             Int              @id @default(autoincrement())
  tahap          String           @unique @db.VarChar(100)
  antrian_pasien AntrianPasiens[]
  created_At     DateTime         @default(now())
  update_At      DateTime         @updatedAt

  @@map("tahap_antrians")
}

model StatusAntrians {
  id             Int              @id @default(autoincrement())
  status         String           @unique @db.VarChar(100)
  antrian_pasien AntrianPasiens[]
  created_At     DateTime         @default(now())
  update_At      DateTime         @updatedAt

  @@map("status_antrians")
}
